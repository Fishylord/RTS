/// Returns the current time in seconds since the Unix epoch.
fn current_time_secs() -> u64 {
    use std::time::{SystemTime, UNIX_EPOCH};
    SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs()
}

// -----------------------------------------------------------------------------
// Dijkstra’s Algorithm for Finding the Shortest Lane Path
// -----------------------------------------------------------------------------

fn find_shortest_path(start: u32, end: u32, lanes: &[Lane]) -> Option<Vec<Lane>> {
    #[derive(Debug)]
    struct LaneState {
        cost: f64,
        position: u32,
    }
    impl Eq for LaneState {}
    impl PartialEq for LaneState {
        fn eq(&self, other: &Self) -> bool {
            self.cost.eq(&other.cost)
        }
    }
    impl Ord for LaneState {
        fn cmp(&self, other: &Self) -> Ordering {
            // Reverse order for min-heap behavior.
            other.cost.partial_cmp(&self.cost).unwrap_or(Ordering::Equal)
        }
    }
    impl PartialOrd for LaneState {
        fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
            Some(self.cmp(other))
        }
    }

    let mut dist: HashMap<u32, f64> = HashMap::new();
    let mut prev: HashMap<u32, (u32, Lane)> = HashMap::new();
    let mut heap = BinaryHeap::new();

    // Initialize distances (using 1..=16 as possible intersections)
    for inter in 1..=16 {
        dist.insert(inter, std::f64::INFINITY);
    }
    dist.insert(start, 0.0);
    heap.push(LaneState { cost: 0.0, position: start });

    // Build mapping: start_intersection -> lanes leaving it.
    let mut lane_map: HashMap<u32, Vec<&Lane>> = HashMap::new();
    for lane in lanes {
        lane_map.entry(lane.start_intersection).or_default().push(lane);
    }

    while let Some(LaneState { cost, position }) = heap.pop() {
        if position == end {
            break;
        }
        if cost > dist[&position] {
            continue;
        }
        if let Some(neighbor_lanes) = lane_map.get(&position) {
            for &lane in neighbor_lanes {
                let next = lane.end_intersection;
                let next_cost = cost + lane.length;
                if next_cost < *dist.get(&next).unwrap_or(&std::f64::INFINITY) {
                    dist.insert(next, next_cost);
                    prev.insert(next, (position, lane.clone()));
                    heap.push(LaneState { cost: next_cost, position: next });
                }
            }
        }
    }

    if !dist.contains_key(&end) || dist[&end] == std::f64::INFINITY {
        return None;
    }

    // Reconstruct the path.
    let mut path = Vec::new();
    let mut current = end;
    while current != start {
        if let Some(&(prev_inter, ref lane)) = prev.get(&current) {
            path.push(lane.clone());
            current = prev_inter;
        } else {
            break;
        }
    }
    path.reverse();
    Some(path)
}

// -----------------------------------------------------------------------------
// Shared Simulation State Definitions
// -----------------------------------------------------------------------------

/// Simulation event: vehicle count per lane.
pub type SimEvent = Arc<Mutex<HashMap<u32, u32>>>;

/// Initialize simulation data by loading lanes and setting counts to zero.
pub fn initialize_simdata() -> SimEvent {
    let mut map = HashMap::new();
    let lanes = load_lanes();
    for lane in lanes {
        map.insert(lane.id, 0);
    }
    Arc::new(Mutex::new(map))
}

/// Light status map: lane id -> current light status.
pub type LightStatusMap = Arc<Mutex<HashMap<u32, String>>>;

/// Lane wait times map: lane id -> (car id -> current waiting time).
pub type LaneWaitTimes = Arc<Mutex<HashMap<u32, HashMap<u32, f64>>>>;

// -----------------------------------------------------------------------------
// Light Status Listener
// -----------------------------------------------------------------------------

/// Listen for light status updates via a RabbitMQ channel and update the shared map.
async fn listen_for_light_statuses(channel: &lapin::Channel, light_status_map: LightStatusMap)
    -> Result<(), Box<dyn std::error::Error>>
{
    channel.exchange_declare(
        "light_status",
        lapin::ExchangeKind::Fanout,
        lapin::options::ExchangeDeclareOptions::default(),
        lapin::types::FieldTable::default()
    ).await?;
    let queue = channel.queue_declare(
        "",
        lapin::options::QueueDeclareOptions::default(),
        lapin::types::FieldTable::default()
    ).await?;
    channel.queue_bind(
        queue.name().as_str(),
        "light_status",
        "",
        lapin::options::QueueBindOptions::default(),
        lapin::types::FieldTable::default()
    ).await?;
    let mut consumer = channel.basic_consume(
        queue.name().as_str(),
        "light_status_consumer",
        lapin::options::BasicConsumeOptions::default(),
        lapin::types::FieldTable::default()
    ).await?;

    println!("Simulation listening for light status updates...");
    while let Some(delivery) = consumer.next().await {
        let delivery = delivery?;
        if let Ok(light_status) = serde_json::from_slice::<LightStatus>(&delivery.data) {
            let mut statuses = light_status_map.lock().await;
            statuses.insert(light_status.lane_id, light_status.status.clone());
            println!("Updated light status for lane {}: {:?}", light_status.lane_id, light_status.status);
        }
        delivery.ack(lapin::options::BasicAckOptions::default()).await?;
    }
    Ok(())
}

// -----------------------------------------------------------------------------
// Spawn Schedule Generation with Hotspot Timings
// -----------------------------------------------------------------------------

fn generate_spawn_schedule() -> Vec<(f64, u32, &'static str)> {
    let intervals = vec![
        SpawnInterval { start: 7.0 * 3600.0,  end: 9.0 * 3600.0,  count: 333, label: "Heavy" },  // Morning hotspot
        SpawnInterval { start: 11.0 * 3600.0, end: 13.0 * 3600.0, count: 333, label: "Heavy" },  // Midday hotspot
        SpawnInterval { start: 17.0 * 3600.0, end: 19.0 * 3600.0, count: 334, label: "Heavy" },  // Evening hotspot
        SpawnInterval { start: 9.0 * 3600.0,  end: 11.0 * 3600.0, count: 175, label: "Medium" },
        SpawnInterval { start: 13.0 * 3600.0, end: 17.0 * 3600.0, count: 350, label: "Medium" },
        SpawnInterval { start: 19.0 * 3600.0, end: 21.0 * 3600.0, count: 175, label: "Medium" },
        SpawnInterval { start: 0.0,           end: 7.0 * 3600.0,  count: 210, label: "Low" },
        SpawnInterval { start: 21.0 * 3600.0, end: 24.0 * 3600.0, count: 90,  label: "Low" },
    ];

    let mut schedule = Vec::new();
    let mut car_id = 1;
    let mut rng = rand::thread_rng();

    for interval in intervals {
        for _ in 0..interval.count {
            let t = rng.gen_range(interval.start..interval.end);
            schedule.push((t, car_id, interval.label));
            car_id += 1;
        }
    }
    // Sort the schedule by spawn time...
    schedule.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap());
    // Reassign car IDs in order so that the first car spawned gets ID 1, etc.
    schedule.into_iter()
        .enumerate()
        .map(|(i, (t, _, label))| (t, (i + 1) as u32, label))
        .collect()
}

// -----------------------------------------------------------------------------
// Car Simulation Function
// -----------------------------------------------------------------------------

/// Simulate a single car's journey. This function now accepts a JSON channel sender so that
/// upon completion, the car sends its route and metrics for logging.
async fn simulate_car(
    car_id: u32,
    spawn_category: &'static str,
    channel: &lapin::Channel,
    sim_event: SimEvent,
    light_status_map: LightStatusMap,
    lane_locks: Arc<HashMap<u32, Arc<Mutex<()>>>>,
    lane_wait_times: LaneWaitTimes,
    json_tx: mpsc::Sender<CarLog>,
) -> CarMetrics {
    let start_time = Instant::now();

    // Use a seeded RNG so that each car has repeatable behavior.
    let mut rng = ChaCha8Rng::seed_from_u64(42 + car_id as u64);
    let speed: f64 = rng.gen_range(3456.0..=7000.0); // adjusted for accelerated time

    // Retrieve lanes and choose random entry/exit points.
    let all_lanes = load_lanes();
    let entry_lanes: Vec<Lane> = all_lanes
        .iter()
        .filter(|l| l.category == LaneCategory::InputBoundary)
        .cloned()
        .collect();
    let exit_lanes: Vec<Lane> = all_lanes
        .iter()
        .filter(|l| l.category == LaneCategory::OutputBoundary)
        .cloned()
        .collect();

    let input_lane = entry_lanes[rng.gen_range(0..entry_lanes.len())].clone();
    let mut exit_lane = exit_lanes[rng.gen_range(0..exit_lanes.len())].clone();
    // Ensure the exit lane is different from the entry lane.
    while exit_lane.id == input_lane.id {
        exit_lane = exit_lanes[rng.gen_range(0..exit_lanes.len())].clone();
    }

    // Compute the internal lane route using Dijkstra’s algorithm.
    let start_intersection = input_lane.end_intersection;
    let end_intersection = exit_lane.start_intersection;
    let internal_lanes: Vec<Lane> = load_lanes()
        .into_iter()
        .filter(|l| l.category == LaneCategory::Internal)
        .collect();
    let lane_route = find_shortest_path(start_intersection, end_intersection, &internal_lanes)
        .unwrap_or_else(Vec::new);

    // Create a vector of internal lane IDs.
    let internal_route_ids: Vec<u32> = lane_route.iter().map(|lane| lane.id).collect();
    // Now build a full route that includes the input lane and exit lane.
    let mut full_route_ids = Vec::new();
    full_route_ids.push(input_lane.id);
    full_route_ids.extend(internal_route_ids.iter().cloned());
    full_route_ids.push(exit_lane.id);

    // Prepare the car's route data including spawn category.
    let mut car_route_data = CarRouteData {
        car_id,
        speed,
        spawn_category: spawn_category.to_string(),
        route: full_route_ids,
        lanes: lane_route
            .iter()
            .map(|lane| LaneWaitData { lane_id: lane.id, waiting_time: 0.0, timestamp: 0 })
            .collect(),
    };

    // Log the generated vehicle details.
    let log = LogEvent {
        source: format!("Car-{}", car_id),
        message: format!(
            "Spawned vehicle (Category: {}) with speed {:.2} m/s; Entry Lane {} (Inter. {}), Exit Lane {} (Inter. {}); Route: {}",
            spawn_category,
            speed,
            input_lane.id,
            input_lane.end_intersection,
            exit_lane.id,
            exit_lane.start_intersection,
            serde_json::to_string(&car_route_data).unwrap()
        ),
        timestamp: current_time_secs(),
    };
    mq::publish_message(channel, "logs", "", &log).await;

    let mut total_wait_time = 0.0;
    let mut total_drive_time = 0.0;

    // Process the entry lane (no waiting).
    if let Some(lock) = lane_locks.get(&input_lane.id) {
        let _guard = lock.lock().await;
        let drive_time = input_lane.length / speed;
        total_drive_time += drive_time;
        sleep(Duration::from_secs_f64(drive_time / ACCELERATION)).await;
    }

    // Process each internal lane.
    for (i, lane) in lane_route.iter().enumerate() {
        if let Some(lock) = lane_locks.get(&lane.id) {
            let _guard = lock.lock().await;
            {
                let mut stats = sim_event.lock().await;
                *stats.entry(lane.id).or_insert(0) += 1;
                println!("Car {} entered lane {}", car_id, lane.id);
            }
            // Start waiting until the light turns green.
            let wait_start = Instant::now();
            {
                let mut wait_map = lane_wait_times.lock().await;
                wait_map.entry(lane.id).or_default().insert(car_id, 0.0);
            }
            loop {
                {
                    let mut wait_map = lane_wait_times.lock().await;
                    if let Some(car_wait) = wait_map.get_mut(&lane.id).and_then(|m| m.get_mut(&car_id)) {
                        *car_wait = wait_start.elapsed().as_secs_f64();
                    }
                }
                let status = {
                    let statuses = light_status_map.lock().await;
                    statuses.get(&lane.id).cloned().unwrap_or("Red".to_string())
                };
                if status == "Green" {
                    break;
                }
                sleep(Duration::from_secs_f64(0.1 / ACCELERATION)).await;
            }
            let lane_wait = wait_start.elapsed().as_secs_f64();
            total_wait_time += lane_wait;
            let exit_timestamp = current_time_secs();
            if let Some(lane_data) = car_route_data.lanes.get_mut(i) {
                lane_data.waiting_time = lane_wait;
                lane_data.timestamp = exit_timestamp;
            }
            {
                let mut wait_map = lane_wait_times.lock().await;
                if let Some(m) = wait_map.get_mut(&lane.id) {
                    m.remove(&car_id);
                }
            }
            // Drive on the lane.
            let seg_time = lane.length / speed;
            total_drive_time += seg_time;
            sleep(Duration::from_secs_f64(seg_time / ACCELERATION)).await;
            {
                let mut stats = sim_event.lock().await;
                *stats.entry(lane.id).or_insert(0) -= 1;
                println!("Car {} left lane {}", car_id, lane.id);
            }
            sleep(Duration::from_secs_f64(0.05 / ACCELERATION)).await;
        }
    }

    // Process the exit lane.
    if let Some(lock) = lane_locks.get(&exit_lane.id) {
        let _guard = lock.lock().await;
        let drive_time = exit_lane.length / speed;
        total_drive_time += drive_time;
        sleep(Duration::from_secs_f64(drive_time / ACCELERATION)).await;
    }

    let total_time = start_time.elapsed().as_secs_f64();
    let comp_log = LogEvent {
        source: format!("Car-{}", car_id),
        message: format!("Completed journey: Wait={:.2}s, Drive={:.2}s, Total={:.2}s", total_wait_time, total_drive_time, total_time),
        timestamp: current_time_secs(),
    };
    mq::publish_message(channel, "logs", "", &comp_log).await;

    // Construct a combined log for JSON output.
    let car_log = CarLog {
        car_route: car_route_data,
        metrics: CarMetrics {
            id: car_id,
            wait_time: total_wait_time,
            drive_time: total_drive_time,
            total_time,
        },
    };

    if let Err(e) = json_tx.send(car_log).await {
        eprintln!("Failed to send JSON log for car {}: {}", car_id, e);
    }

    CarMetrics {
        id: car_id,
        wait_time: total_wait_time,
        drive_time: total_drive_time,
        total_time,
    }
}

// -----------------------------------------------------------------------------
// Main Simulation Entry Point
// -----------------------------------------------------------------------------

#[tokio::main]
async fn main() {
    // Set up messaging channels and declare exchanges.
    let channel = mq::create_channel().await;
    mq::declare_exchange(&channel, "simulation.updates", lapin::ExchangeKind::Fanout).await;
    mq::declare_exchange(&channel, "logs", lapin::ExchangeKind::Fanout).await;
    mq::declare_exchange(&channel, "light_status", lapin::ExchangeKind::Fanout).await;

    let sim_event = initialize_simdata();
    let light_status_map: LightStatusMap = Arc::new(Mutex::new(HashMap::new()));

    // Spawn a task to listen for light status updates.
    let channel_clone = channel.clone();
    let light_status_map_clone = Arc::clone(&light_status_map);
    tokio::spawn(async move {
        if let Err(e) = listen_for_light_statuses(&channel_clone, light_status_map_clone).await {
            eprintln!("Error listening for light statuses: {}", e);
        }
    });

    // Create per-lane locks to ensure FIFO ordering.
    let lanes = load_lanes();
    let mut locks_map = HashMap::new();
    for lane in &lanes {
        locks_map.insert(lane.id, Arc::new(Mutex::new(())));
    }
    let lane_locks = Arc::new(locks_map);

    // Initialize lane wait times map.
    let mut wait_times_map = HashMap::new();
    for lane in &lanes {
        wait_times_map.insert(lane.id, HashMap::new());
    }
    let lane_wait_times: LaneWaitTimes = Arc::new(Mutex::new(wait_times_map));

    // Set up the JSON logger channel and spawn the logger task.
    let (json_tx, mut json_rx) = mpsc::channel::<CarLog>(100);
    tokio::spawn(async move {
        let file_path = "car_simulation_logs.json";
        let mut file = std::fs::OpenOptions::new()
            .create(true)
            .append(true)
            .open(file_path)
            .expect("Unable to open log file");
        while let Some(car_log) = json_rx.recv().await {
            let json_str = serde_json::to_string(&car_log).expect("Failed to serialize car log");
            if let Err(e) = writeln!(file, "{}", json_str) {
                eprintln!("Failed to write to log file: {}", e);
            }
        }
    });

    // Background task: publish lane statistics every simulated second.
    let channel_stats = channel.clone();
    let sim_event_stats = Arc::clone(&sim_event);
    let lane_wait_times_stats = Arc::clone(&lane_wait_times);
    tokio::spawn(async move {
        loop {
            let mut stats_msgs = Vec::new();
            {
                let sim_data = sim_event_stats.lock().await;
                let wait_data = lane_wait_times_stats.lock().await;
                for (&lane_id, &vehicle_count) in sim_data.iter() {
                    let (sum, count, cars) = if let Some(car_waits) = wait_data.get(&lane_id) {
                        let (s, c) = car_waits.values().fold((0.0, 0), |(s, c), &wt| (s + wt, c + 1));
                        let cars: Vec<CarWaitInfo> = car_waits
                            .iter()
                            .map(|(&cid, &wt)| CarWaitInfo { car_id: cid, waiting_time: wt })
                            .collect();
                        (s, c, cars)
                    } else {
                        (0.0, 0, Vec::new())
                    };
                    let avg_wait = if count > 0 { sum / count as f64 } else { 0.0 };
                    let lane_stat = TrafficUpdate {
                        lane_id,
                        vehicle_count,
                        average_waiting_time: avg_wait,
                        cars,
                        timestamp: current_time_secs(),
                    };
                    stats_msgs.push(lane_stat);
                }
            }
            for stat in stats_msgs {
                mq::publish_message(&channel_stats, "simulation.updates", "", &stat).await;
            }
            sleep(Duration::from_secs_f64(1.0 / ACCELERATION)).await;
        }
    });

    // Car Generation: Schedule vehicles based on the spawn schedule.
    let spawn_schedule = generate_spawn_schedule();
    let sim_start = Instant::now();
    let mut handles = Vec::new();

    for (spawn_time_sim, car_id, spawn_category) in spawn_schedule {
        // Convert simulation spawn time to wall clock delay.
        let desired_wall_time = spawn_time_sim / ACCELERATION;
        let now = sim_start.elapsed().as_secs_f64();
        if desired_wall_time > now {
            sleep(Duration::from_secs_f64(desired_wall_time - now)).await;
        }
        let channel_clone = channel.clone();
        let sim_event_clone = Arc::clone(&sim_event);
        let light_status_map_clone = Arc::clone(&light_status_map);
        let lane_locks_clone = Arc::clone(&lane_locks);
        let lane_wait_times_clone = Arc::clone(&lane_wait_times);
        let json_tx_clone = json_tx.clone();
        let handle = tokio::spawn(async move {
            simulate_car(
                car_id,
                spawn_category,
                &channel_clone,
                sim_event_clone,
                light_status_map_clone,
                lane_locks_clone,
                lane_wait_times_clone,
                json_tx_clone,
            ).await
        });
        handles.push(handle);
    }

    // Wait for all car simulation tasks to complete and aggregate their metrics.
    let mut metrics_vec = Vec::new();
    for handle in handles {
        if let Ok(metrics) = handle.await {
            metrics_vec.push(metrics);
        }
    }

    let count = metrics_vec.len() as f64;
    let total_wait: f64 = metrics_vec.iter().map(|m| m.wait_time).sum();
    let total_drive: f64 = metrics_vec.iter().map(|m| m.drive_time).sum();
    let total_total: f64 = metrics_vec.iter().map(|m| m.total_time).sum();

    let avg_wait = total_wait / count;
    let avg_drive = total_drive / count;
    let avg_total = total_total / count;

    println!("Average Metrics: Wait={:.2}s, Drive={:.2}s, Total={:.2}s", avg_wait, avg_drive, avg_total);

    let avg_log = LogEvent {
        source: "Simulation".into(),
        message: format!("Average Metrics: Wait={:.2}s, Drive={:.2}s, Total={:.2}s", avg_wait, avg_drive, avg_total),
        timestamp: current_time_secs(),
    };
    mq::publish_message(&channel, "logs", "", &avg_log).await;

    // Send final completion message.
    let complete_msg = LogEvent {
        source: "Simulation".into(),
        message: "SIMULATION_COMPLETE".into(),
        timestamp: current_time_secs(),
    };
    mq::publish_message(&channel, "logs", "", &complete_msg).await;
}