/// Simulation acceleration factor.
/// (86400 simulated seconds, i.e. 24 hours, are compressed into 150 seconds real time)
const ACCELERATION: f64 = 576.0;

/// SpawnInterval struct defines simulation intervals.
/// The label helps identify hotspot (heavy) intervals.
struct SpawnInterval {
    start: f64,   // start time in simulation seconds
    end: f64,     // end time in simulation seconds
    count: u32,   // number of cars to spawn in this interval
    label: &'static str, // e.g., "Heavy", "Medium", "Low"
}

// -----------------------------------------------------------------------------
// Data Structures for Messaging and Metrics
// -----------------------------------------------------------------------------

#[derive(Serialize, Deserialize)]
pub struct TrafficUpdate {
    pub lane_id: u32,
    pub vehicle_count: u32,
    pub average_waiting_time: f64,
    pub cars: Vec<CarWaitInfo>,
    pub timestamp: u64,
}

#[derive(Serialize, Deserialize)]
pub struct CarWaitInfo {
    pub car_id: u32,
    pub waiting_time: f64,
}

#[derive(Serialize, Deserialize)]
pub struct LogEvent {
    pub source: String,
    pub message: String,
    pub timestamp: u64,
}

/// Data structure for per-car route information.
/// Now, the "route" field includes the input lane, all internal lanes, and the exit lane.
#[derive(Serialize, Deserialize, Debug)]
pub struct CarRouteData {
    pub car_id: u32,
    pub speed: f64,
    pub spawn_category: String,
    pub route: Vec<u32>, // all lane IDs in order: input, internal, exit
    pub lanes: Vec<LaneWaitData>, // detailed waiting data for each internal lane
}

/// Modified to include a timestamp when the car leaves the lane.
#[derive(Serialize, Deserialize, Debug)]
pub struct LaneWaitData {
    pub lane_id: u32,
    pub waiting_time: f64,
    pub timestamp: u64,
}

#[derive(Serialize, Deserialize, Debug)]
pub struct CarMetrics {
    pub id: u32,
    pub wait_time: f64,
    pub drive_time: f64,
    pub total_time: f64,
}

/// Structure to combine the route data and metrics for JSON logging.
#[derive(Serialize, Deserialize, Debug)]
pub struct CarLog {
    pub car_route: CarRouteData,
    pub metrics: CarMetrics,
}

